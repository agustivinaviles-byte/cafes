# ───────────── General ─────────────
PORT=3001
NODE_ENV=development
# URL pública HTTPS donde vive esta API (Apple y Google la necesitan para
# descargar logos y para el servicio web de actualizaciones).
# En local puedes usar un túnel: ngrok http 3001  →  https://xxxx.ngrok-free.app
PUBLIC_URL=http://localhost:3001
# URL del frontend para el QR de inscripción. En desarrollo usa la IP de tu
# computadora para abrirlo desde el celular (ej. http://192.168.1.50:5173).
# En producción déjala vacía (el frontend se sirve desde PUBLIC_URL).
CLIENT_URL=http://172.31.221.44:5173
# Orígenes permitidos por CORS (separados por coma). En producción el
# frontend se sirve desde el mismo servidor y esto casi no se usa.
CORS_ORIGINS=http://localhost:5173
# Carpeta de datos (base de datos JSON + logos procesados)
DATA_DIR=./data

# ───────────── Apple Wallet ─────────────
# Ver README → "Certificados de Apple"
APPLE_PASS_TYPE_ID=pass.com.tunegocio.loyalty
APPLE_TEAM_ID=ABCDE12345
APPLE_WWDR_CERT=./certs/wwdr.pem
APPLE_SIGNER_CERT=./certs/signerCert.pem
APPLE_SIGNER_KEY=./certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
# true = api.sandbox.push.apple.com (solo si tu certificado es de desarrollo)
APPLE_APNS_SANDBOX=false

# ───────────── Google Wallet ─────────────
# Ver README → "Google Wallet API"
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_SERVICE_ACCOUNT_FILE=./certs/google-service-account.json
# Código de país para las clases de lealtad
GOOGLE_COUNTRY_CODE=MX
